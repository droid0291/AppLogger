<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F1A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="UI Bug Simulations"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#6B9FFF"
            android:paddingBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Visual bugs are shown live on this screen. Use the toggle to switch between the broken and fixed state."
            android:textSize="13sp"
            android:textColor="#8888AA"
            android:paddingBottom="24dp" />

        <!-- Overlapping Views -->
        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="#08081A">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Overlapping Views"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#6B9FFF" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Incorrect z ordering or layout margins cause a label to render on top of a button."
                    android:textSize="13sp"
                    android:textColor="#6666AA"
                    android:paddingTop="4dp"
                    android:paddingBottom="12dp" />

                <!-- The live demo area -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginBottom="10dp">
                    <Button
                        android:id="@+id/demoOverlapButton"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="Tap Me"
                        android:backgroundTint="#1E88E5"
                        android:textColor="#FFFFFF" />
                    <TextView
                        android:id="@+id/demoOverlapText"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="This label overlaps the button!"
                        android:textColor="#FF6B6B"
                        android:background="#CC000000"
                        android:gravity="center"
                        android:textSize="13sp"
                        android:visibility="visible" />
                </FrameLayout>
                <Button
                    android:id="@+id/btnToggleOverlap"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="Toggle: Show Fix"
                    android:backgroundTint="#283593"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Text Truncation -->
        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="#08081A">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Text Overflow / Truncation"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#6B9FFF" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="A username with no maxLines or ellipsize constraint breaks the layout."
                    android:textSize="13sp"
                    android:textColor="#6666AA"
                    android:paddingTop="4dp"
                    android:paddingBottom="12dp" />

                <TextView
                    android:id="@+id/demoTruncText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Username: VeryLongUsernameWithAbsolutelyNoEllipsisHandling_Which_Will_Push_Everything_Off_Screen_1234567890"
                    android:textSize="14sp"
                    android:textColor="#CCCCCC"
                    android:background="#222233"
                    android:padding="10dp"
                    android:layout_marginBottom="10dp"
                    android:maxLines="1"
                    android:ellipsize="none" />
                <Button
                    android:id="@+id/btnToggleTruncation"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="Toggle: Show Fix (ellipsize)"
                    android:backgroundTint="#283593"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Low Contrast -->
        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="#08081A">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Low Contrast (Accessibility Fail)"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#6B9FFF" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Near-white text on white background. Fails WCAG 2.1 contrast ratio (&lt; 4.5:1). Invisible to low-vision users."
                    android:textSize="13sp"
                    android:textColor="#6666AA"
                    android:paddingTop="4dp"
                    android:paddingBottom="12dp" />
                <Button
                    android:id="@+id/demoContrastButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Submit Payment"
                    android:backgroundTint="#FFFFFF"
                    android:textColor="#EEEEEE"
                    android:layout_marginBottom="10dp" />
                <Button
                    android:id="@+id/btnToggleContrast"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="Toggle: Show Fix (proper contrast)"
                    android:backgroundTint="#283593"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Missing Image -->
        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="#08081A">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Missing / Broken Image"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#6B9FFF" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ImageView has no src set and no placeholder. Leaves a blank gap that confuses users. No error shown in UI."
                    android:textSize="13sp"
                    android:textColor="#6666AA"
                    android:paddingTop="4dp"
                    android:paddingBottom="12dp" />
                <ImageView
                    android:id="@+id/demoImageView"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:background="#222233"
                    android:scaleType="centerCrop"
                    android:layout_marginBottom="10dp"
                    android:contentDescription="Product image" />
                <Button
                    android:id="@+id/btnToggleImage"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="Toggle: Show Fix (placeholder)"
                    android:backgroundTint="#283593"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
