<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F1A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🌐 Network Failures"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#6BFF9F"
            android:paddingBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Each simulation fires a real network request. Watch the status card and Logcat for the error details."
            android:textSize="13sp"
            android:textColor="#8888AA"
            android:paddingBottom="24dp" />

        <!-- Network Timeout -->
        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="#081A0E">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Network Timeout"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#6BFF9F" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Connects to a non-routable IP (10.255.255.1) with an 8s timeout. Simulates a slow API or dead server. UI should show a loading state during this time."
                    android:textSize="13sp"
                    android:textColor="#447755"
                    android:paddingTop="4dp"
                    android:paddingBottom="10dp" />
                <TextView
                    android:id="@+id/statusTimeout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⬤  Ready"
                    android:textSize="12sp"
                    android:textColor="#555555"
                    android:background="#111111"
                    android:padding="8dp"
                    android:layout_marginBottom="10dp" />
                <Button
                    android:id="@+id/btnTriggerTimeout"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="▶ Simulate Network Timeout"
                    android:backgroundTint="#2E7D32"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- HTTP 500 -->
        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="#081A0E">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="HTTP 500 Server Error"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#6BFF9F" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Calls httpstat.us/500 which returns a real HTTP 500 response. A correct app shows a user-friendly error; a buggy one shows a blank screen or crashes."
                    android:textSize="13sp"
                    android:textColor="#447755"
                    android:paddingTop="4dp"
                    android:paddingBottom="10dp" />
                <TextView
                    android:id="@+id/statusHttp500"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⬤  Ready"
                    android:textSize="12sp"
                    android:textColor="#555555"
                    android:background="#111111"
                    android:padding="8dp"
                    android:layout_marginBottom="10dp" />
                <Button
                    android:id="@+id/btnTriggerHttp500"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="▶ Simulate HTTP 500"
                    android:backgroundTint="#2E7D32"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Offline -->
        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="#081A0E">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No Internet / Offline"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#6BFF9F" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Checks connectivity then makes an API call without a guard. Turn off Wi-Fi and mobile data first, then trigger to see the UnknownHostException in Logcat."
                    android:textSize="13sp"
                    android:textColor="#447755"
                    android:paddingTop="4dp"
                    android:paddingBottom="10dp" />
                <TextView
                    android:id="@+id/statusOffline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⬤  Ready"
                    android:textSize="12sp"
                    android:textColor="#555555"
                    android:background="#111111"
                    android:padding="8dp"
                    android:layout_marginBottom="10dp" />
                <Button
                    android:id="@+id/btnTriggerOffline"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="▶ Simulate Offline API Call"
                    android:backgroundTint="#2E7D32"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
