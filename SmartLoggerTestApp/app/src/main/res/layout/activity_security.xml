<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F1A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔐 Security Simulations"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#AAAAAA"
            android:paddingBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Demonstrates common security misconfigurations detectable by SmartLogger's logcat analysis."
            android:textSize="13sp"
            android:textColor="#8888AA"
            android:paddingBottom="24dp" />

        <!-- PII in Logs -->
        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="#141414">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PII / Credentials in Logcat"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#AAAAAA" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Writes user email, password, auth token, credit card number, and SSN to Logcat using Log.d(). Readable via ADB by anyone with USB access or a rooted device."
                    android:textSize="13sp"
                    android:textColor="#666666"
                    android:paddingTop="4dp"
                    android:paddingBottom="10dp" />

                <!-- Logcat preview box -->
                <TextView
                    android:id="@+id/piiPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Logcat output will appear here after triggering..."
                    android:textSize="11sp"
                    android:textColor="#44FF88"
                    android:fontFamily="monospace"
                    android:background="#0D1F0D"
                    android:padding="10dp"
                    android:layout_marginBottom="10dp" />

                <Button
                    android:id="@+id/btnLogPii"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="▶ Log Sensitive Data"
                    android:backgroundTint="#424242"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- FLAG_SECURE -->
        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="#141414">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="FLAG_SECURE (Screenshot Protection)"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#AAAAAA" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="When OFF: SmartLogger (and ADB) can capture screenshots of this screen — a security risk for banking/payment screens. Toggle ON to block all screenshot capture."
                    android:textSize="13sp"
                    android:textColor="#666666"
                    android:paddingTop="4dp"
                    android:paddingBottom="12dp" />
                <TextView
                    android:id="@+id/statusSecure"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🔓  STATUS: INSECURE — screenshots allowed"
                    android:textSize="13sp"
                    android:textColor="#FF6B6B"
                    android:background="#1A0A0A"
                    android:padding="10dp"
                    android:layout_marginBottom="12dp" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/secureToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enable FLAG_SECURE"
                    android:textColor="#AAAAAA" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
